PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Docker MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nest_ecommerce_db
DB_USER=nest_user
DB_PASSWORD=nest_password_123
DATABASE_URL="mysql://nest_user:nest_password_123@localhost:3306/nest_ecommerce_db"

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Mailtrap / SMTP Mailer
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mail_username
MAIL_PASS=your_mail_password
MAIL_FROM="Rya Store <no-reply@ryastore.com>"

# SePay Webhook Integration
SEPAY_API_TOKEN=your_sepay_api_token
