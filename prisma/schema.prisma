generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid()) @db.VarChar(36)
  phone       String?   @unique @db.VarChar(15)
  email       String?   @unique @db.VarChar(255)
  password    String?   @db.VarChar(255) // Nullable for social login if added later
  role        Role      @default(USER)
  name        String?   @map("name") @db.VarChar(255)
  avatarUrl   String?   @map("avatar_url") @db.Text
  gender      Gender?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  otp_code    String?   @map("otp_code") @db.VarChar(10)
  otp_expires_at DateTime? @map("otp_expires_at") @db.DateTime
  email_verified_at DateTime? @map("email_verified_at") @db.DateTime
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  addresses    Address[]
  cart         Cart?
  orders       Order[]
  couponUsages CouponUsage[]
  wishlists    Wishlist[]
  reviews      Review[]

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  USER
  ADMIN
}

model Address {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  fullName  String   @map("full_name") @db.VarChar(255)
  phone     String   @db.VarChar(15)
  province  String   @db.VarChar(100)
  district  String   @db.VarChar(100)
  ward      String   @db.VarChar(100)
  street    String   @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ==========================================
// 2. PRODUCT CATALOG
// ==========================================

model Category {
  id        String   @id @default(uuid()) @db.VarChar(36)
  parentId  String?  @map("parent_id") @db.VarChar(36)
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  imageUrl  String?  @map("image_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]

  @@map("categories")
}

model Collection {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  eyebrow     String?  @db.VarChar(100)
  imageUrl    String?  @map("image_url") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products    Product[] @relation("ProductCollections")

  @@map("collections")
}

model Product {
  id              String         @id @default(uuid()) @db.VarChar(36)
  categoryId      String?        @map("category_id") @db.VarChar(36)
  name            String         @db.VarChar(500)
  slug            String         @unique @db.VarChar(500)
  description     String?        @db.Text
  basePrice       Decimal        @map("base_price") @db.Decimal(12, 2)
  salePrice       Decimal?       @map("sale_price") @db.Decimal(12, 2)
  gender          ProductGender?
  status          ProductStatus  @default(DRAFT)
  isFeatured      Boolean        @default(false) @map("is_featured")
  tags            Json? // Array of strings
  metaTitle       String?        @map("meta_title") @db.VarChar(255)
  metaDescription String?        @map("meta_description") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  category  Category?        @relation(fields: [categoryId], references: [id])
  collections Collection[]   @relation("ProductCollections")
  images    ProductImage[]
  variants  ProductVariant[]
  wishlists Wishlist[]
  reviews   Review[]

  @@fulltext([name, description])
  @@map("products")
}

enum ProductGender {
  MALE
  FEMALE
  UNISEX
  KIDS
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model ProductImage {
  id        String  @id @default(uuid()) @db.VarChar(36)
  productId String  @map("product_id") @db.VarChar(36)
  url       String  @db.Text
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model VariantImage {
  id        String  @id @default(uuid()) @db.VarChar(36)
  variantId String  @map("variant_id") @db.VarChar(36)
  url       String  @db.Text
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_images")
}

// ==========================================
// 3. ATTRIBUTES & VARIANTS
// ==========================================

model Attribute {
  id   String        @id @default(uuid()) @db.VarChar(36)
  name String        @db.VarChar(100) // "Size", "Color", "Material"
  type String        @db.VarChar(50) // "color", "button", "dropdown"

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String  @id @default(uuid()) @db.VarChar(36)
  attributeId String  @map("attribute_id") @db.VarChar(36)
  value       String  @db.VarChar(100)
  hexCode     String? @map("hex_code") @db.VarChar(7)
  sortOrder   Int     @default(0) @map("sort_order")

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  VariantAttributeValue[]

  @@map("attribute_values")
}

model ProductVariant {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  productId          String   @map("product_id") @db.VarChar(36)
  sku                String   @unique @db.VarChar(100)
  priceOverride      Decimal? @map("price_override") @db.Decimal(12, 2)
  salePriceOverride  Decimal? @map("sale_price_override") @db.Decimal(12, 2)
  stockQty           Int      @default(0) @map("stock_qty")
  weightGram         Int?     @map("weight_gram")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  product       Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes    VariantAttributeValue[]
  images        VariantImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String @map("variant_id") @db.VarChar(36)
  attributeValueId String @map("attribute_value_id") @db.VarChar(36)

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@id([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

// ==========================================
// 4. INVENTORY LOGS
// ==========================================

model InventoryLog {
  id          String          @id @default(uuid()) @db.VarChar(36)
  variantId   String          @map("variant_id") @db.VarChar(36)
  changeQty   Int             @map("change_qty") // Âm = trừ, Dương = cộng
  reason      InventoryReason
  referenceId String?         @map("reference_id") @db.VarChar(36) // Order ID / Return ID
  note        String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory_logs")
}

enum InventoryReason {
  ORDER
  RETURN
  RESTOCK
  ADJUSTMENT
}

// ==========================================
// 5. CART
// ==========================================

model Cart {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @unique @map("user_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.VarChar(36)
  cartId    String   @map("cart_id") @db.VarChar(36)
  variantId String   @map("variant_id") @db.VarChar(36)
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ==========================================
// 6. ORDERS & PAYMENTS
// ==========================================

model Order {
  id        String  @id @default(uuid()) @db.VarChar(36)
  orderCode String  @unique @map("order_code") @db.VarChar(20)
  userId    String? @map("user_id") @db.VarChar(36)

  // Snapshot địa chỉ
  shippingName     String @map("shipping_name") @db.VarChar(255)
  shippingPhone    String @map("shipping_phone") @db.VarChar(15)
  shippingAddress  String @map("shipping_address") @db.Text
  shippingProvince String @map("shipping_province") @db.VarChar(100)

  // Tiền bạc
  subtotal       Decimal @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  // Trạng thái
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")

  couponId        String? @map("coupon_id") @db.VarChar(36)
  note            String? @db.Text
  cancelledReason String? @map("cancelled_reason") @db.Text

  confirmedAt DateTime? @map("confirmed_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User?            @relation(fields: [userId], references: [id])
  coupon      Coupon?          @relation(fields: [couponId], references: [id])
  items       OrderItem[]
  statusLogs  OrderStatusLog[]
  payment     Payment?
  couponUsage CouponUsage?

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model OrderItem {
  id        String  @id @default(uuid()) @db.VarChar(36)
  orderId   String  @map("order_id") @db.VarChar(36)
  variantId String? @map("variant_id") @db.VarChar(36)

  // Snapshot thông tin sản phẩm
  productName String  @map("product_name") @db.VarChar(500)
  variantInfo Json    @map("variant_info") // {"color": "Red", "size": "M"}
  sku         String  @db.VarChar(100)
  imageUrl    String? @map("image_url") @db.Text
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@map("order_items")
}

model OrderStatusLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  orderId   String   @map("order_id") @db.VarChar(36)
  oldStatus String?  @map("old_status") @db.VarChar(50)
  newStatus String   @map("new_status") @db.VarChar(50)
  note      String?  @db.Text
  createdBy String?  @map("created_by") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_logs")
}

model Payment {
  id              String               @id @default(uuid()) @db.VarChar(36)
  orderId         String               @unique @map("order_id") @db.VarChar(36)
  gateway         PaymentMethod
  gatewayTxnId    String?              @map("gateway_txn_id") @db.VarChar(255)
  amount          Decimal              @db.Decimal(12, 2)
  status          PaymentGatewayStatus
  gatewayResponse Json?                @map("gateway_response")
  paidAt          DateTime?            @map("paid_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentGatewayStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==========================================
// 7. COUPONS
// ==========================================

model Coupon {
  id            String     @id @default(uuid()) @db.VarChar(36)
  code          String     @unique @db.VarChar(50)
  type          CouponType
  value         Decimal    @db.Decimal(12, 2)
  minOrderValue Decimal?   @default(0) @map("min_order_value") @db.Decimal(12, 2)
  maxDiscount   Decimal?   @map("max_discount") @db.Decimal(12, 2)
  usageLimit    Int?       @map("usage_limit")
  usedCount     Int        @default(0) @map("used_count")
  startDate     DateTime?  @map("start_date")
  endDate       DateTime?  @map("end_date")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")

  orders Order[]
  usages CouponUsage[]

  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model CouponUsage {
  id       String   @id @default(uuid()) @db.VarChar(36)
  couponId String   @map("coupon_id") @db.VarChar(36)
  userId   String   @map("user_id") @db.VarChar(36)
  orderId  String   @unique @map("order_id") @db.VarChar(36)
  usedAt   DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@map("coupon_usages")
}

// ==========================================
// 8. WISHLIST & REVIEWS
// ==========================================

model Wishlist {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  productId String   @map("product_id") @db.VarChar(36)
  addedAt   DateTime @default(now()) @map("added_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Review {
  id          String       @id @default(uuid()) @db.VarChar(36)
  productId   String       @map("product_id") @db.VarChar(36)
  userId      String       @map("user_id") @db.VarChar(36)
  orderItemId String?      @map("order_item_id") @db.VarChar(36)
  rating      Int          @db.SmallInt
  comment     String?      @db.Text
  images      Json? // Array of URLs
  isVerified  Boolean      @default(false) @map("is_verified")
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// 9. CMS / SETTINGS
// ==========================================

model Setting {
  keyName   String   @id @map("key_name") @db.VarChar(100)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}
